# Environment variables (KAIONEX marketing site)
#
# Copy to `.env.local` for local overrides. Never commit secrets.

# ==============================================================================
# PUBLIC (safe for the browser) — use NEXT_PUBLIC_ prefix
# ==============================================================================

# Canonical marketing site URL (no trailing slash). Default: https://kaionex.app
NEXT_PUBLIC_SITE_URL=https://kaionex.app

# Reserved for future application login – Sign In UI is hidden until an app exists
NEXT_PUBLIC_SIGN_IN_URL=

# Optional analytics provider id (no SDK shipped until wired)
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Optional Cloudflare Turnstile site key (do not enable UI without a real key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# Supabase (public — safe for browser)
# Get from: Supabase Dashboard → Settings → API → Project URL & publishable key
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# SERVER-ONLY (never use NEXT_PUBLIC_ for these)
# ==============================================================================

# Official inbox for all demo/contact/CRM-update leads
CONTACT_RECIPIENT_EMAIL=info@kaionex.app

# Verified sender address; configure only after choosing an email provider
LEAD_FROM_EMAIL=

# Optional temporary lead bridge until transactional email is wired
LEAD_WEBHOOK_URL=

# Optional bearer token sent as Authorization: Bearer <secret>
LEAD_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Supabase — secret key (SERVER ONLY — NEVER expose to browser)
# Get from: Supabase Dashboard → Settings → API → secret key
# CRITICAL: This key bypasses all Row-Level Security policies.
# ------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# ==============================================================================
# NOTES
# ==============================================================================
#
# - KAIONEX CMS (Phase D1) requires NEXT_PUBLIC_SUPABASE_URL,
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, and SUPABASE_SECRET_KEY.
#
# - Set these in .env.local (gitignored). Never commit real values.
#
# - Target form delivery method is email. No provider is connected until
#   credentials exist. If delivery is unconfigured, forms use honest
#   Email/WhatsApp fallback.
#
# - Sign In remains hidden regardless of NEXT_PUBLIC_SIGN_IN_URL until
#   the product enables it.
#
# - See docs/CMS_SETUP.md for first-admin provisioning and full setup guide.
